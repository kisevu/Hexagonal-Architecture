===============================================================
HEXAGONAL ARCHITECTURE
LOCAL DEVELOPMENT ENVIRONMENT
Copy this file to .env.
Never commit .env to Git.
===============================================================
---------------------------------------------------------------
APPLICATION
---------------------------------------------------------------

APP_NAME=Hexagonal-Architecture

---------------------------------------------------------------
POSTGRESQL
---------------------------------------------------------------

DB_NAME=mydb

POSTGRES_IMAGE_TAG=17

PostgreSQL bootstrap superuser

POSTGRES_SUPERUSER=postgres POSTGRES_SUPERUSER_PASSWORD=local-super-pw

Schema owner: Flyway migrations (DDL)

DB_OWNER_USER=demo_owner DB_OWNER_PASSWORD=local-owner-pw

Application user: DML only

DB_APP_USER=demo_app DB_APP_PASSWORD=local-app-pw

---------------------------------------------------------------
HASHICORP VAULT
---------------------------------------------------------------

VAULT_IMAGE_TAG=2.1.0

Local development root token

VAULT_DEV_ROOT_TOKEN=local-root-token

Application AppRole credentials

VAULT_APP_ROLE_ID=demo-local-role-id VAULT_APP_SECRET_ID=demo-local-secret-id

---------------------------------------------------------------
KEYCLOAK
---------------------------------------------------------------

KEYCLOAK_IMAGE_TAG=26.7.1

KEYCLOAK_HOST_PORT=8180

KEYCLOAK_ADMIN_USER=admin KEYCLOAK_ADMIN_PASSWORD=local-admin-pw

Machine-to-machine OAuth2 clients

DEMO_SERVICE_CLIENT_SECRET=local-demo-service-secret DEMO_READONLY_CLIENT_SECRET=local-demo-readonly-secret

---------------------------------------------------------------
REDIS
---------------------------------------------------------------

REDIS_IMAGE_TAG=8.8

REDIS_HOST_PORT=6379

REDIS_MAX_MEMORY=128mb

REDIS_APP_USER=demo REDIS_APP_PASSWORD=local-redis-pw

---------------------------------------------------------------
GRAFANA LGTM / OPENTELEMETRY
---------------------------------------------------------------

LGTM_IMAGE_TAG=0.30.0

GRAFANA_HOST_PORT=3000

OTEL_GRPC_PORT=4317 OTEL_HTTP_PORT=4318